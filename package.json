{
  "name": "a11y-audit-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Small tracker for logging and resolving accessibility issues found during audits.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "reset-db": "node -e \"require('fs').rmSync('data', { recursive: true, force: true })\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-session": "^2.1.1",
    "ejs": "^7.0.1",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
