<% const entries = Object.entries(errors || {}); if (entries.length) { %>
  <section class="error-summary" id="error-summary" tabindex="-1" aria-labelledby="error-summary-title">
    <h2 id="error-summary-title">There <%= entries.length === 1 ? 'is a problem' : `are ${entries.length} problems` %> with this form</h2>
    <ul>
      <% entries.forEach(([field, message]) => { %>
        <li><a href="#<%= field %>"><%= message %></a></li>
      <% }) %>
    </ul>
  </section>
<% } %>
